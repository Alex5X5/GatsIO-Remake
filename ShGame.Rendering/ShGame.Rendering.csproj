<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!-- or linux-x64, etc. -->
		<TargetFramework>net10.0</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWin32Manifest>true</NoWin32Manifest>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<WarningLevel>1</WarningLevel>
		<NoWarn>1701;1702;IDE0055,CS8602,CS8500</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<WarningLevel>1</WarningLevel>
		<NoWarn>1701;1702;IDE0055</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="push_sh.bat" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="..\libs\Simplelogging.dll" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Assets\**\*" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ShGame.Drawing\ShGame.Drawing.csproj" />
		<ProjectReference Include="..\ShGame.Game\ShGame.Game.csproj" />
		<ProjectReference Include="..\ShGame.Math\ShGame.Math.csproj" />
	</ItemGroup>
</Project>
